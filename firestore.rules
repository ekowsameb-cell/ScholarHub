rules_version = '2';

// ScholarHub Firestore rules.
// IMPORTANT: the bundled Firebase apiKey is PUBLIC by design — it does NOT
// protect data. These rules ARE the protection. Test mode (default) allows
// anyone read/write for ~30 days; REPLACE with these before real schools use it.
//
// Current posture: require a signed-in user for any read/write on the school
// doc. Until Firebase Auth is enabled in sync.js, this will BLOCK all access
// (desired: it forces turning on Auth, not leaving it open). Once Auth is on,
// authenticated users share the school doc. Tighten per-role next.
service cloud.firestore {
  match /databases/{database}/documents {
    match /schools/{schoolId} {
      allow read, write: if request.auth != null;
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
