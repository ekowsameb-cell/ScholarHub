rules_version = '2';

// ============================================================================
// ScholarHub ERP — Firestore security rules (HARDENED TARGET)
//
// NOTE: These rules enforce authorization via Firebase Auth *custom claims*
// (role, schoolId). The current app uses a localStorage session ("mock login")
// and does NOT yet mint these claims, so cloud writes/reads are denied by
// design until a real auth + claims system lands (see ARCHITECTURE.md §4).
// The app remains fully functional local-first from localStorage.
//
// Activate with:  firebase deploy --only firestore   (requires `firebase login`)
// (The GitHub Actions hosting deploy does NOT push rules.)
// ============================================================================

service cloud.firestore {
  // ----------------------------------------------------------------
  // Helper functions
  // ----------------------------------------------------------------
  function isSignedIn() {
    return request.auth != null;
  }

  function role() {
    return request.auth.token.role;
  }

  function schoolId() {
    return request.auth.token.schoolId;
  }

  // A document may be touched only if it belongs to the caller's school.
  function sameSchool(res) {
    return res.data.schoolId == schoolId();
  }

  // Role allowed to write a given collection.
  function canWrite(collection) {
    return role() in ['Owner', 'Admin']
      || (collection == 'grades'         && role() in ['Teacher', 'HOD', 'Headmaster', 'Admin', 'Owner'])
      || (collection == 'attendance'      && role() in ['Teacher', 'Admin', 'Owner'])
      || (collection == 'feeTransactions'  && role() in ['Cashier', 'Admin', 'Owner'])
      || (collection == 'lessonPlans'     && role() in ['Teacher', 'HOD', 'Headmaster', 'Admin', 'Owner'])
      || (collection == 'users'           && role() in ['Owner', 'Admin']);
  }

  // ----------------------------------------------------------------
  // Collection rules
  // ----------------------------------------------------------------
  match /databases/{database}/documents {
    // Connectivity probe – any signed-in user can read (used by OfflineBanner)
    match /connectivity/{docId} {
      allow read: if isSignedIn();
    }

    // School-scoped collections
    match /{c=users|students|classes|subjects|grades|attendance|feeTransactions|
              lessonPlans|approvals|tasks|timetable|assignments|
              compensationProfiles|salaryApprovals|payrollLedger}/{docId} {
      allow read:  if isSignedIn() && sameSchool(resource);
      allow write: if isSignedIn()
                   && schoolId() == request.resource.data.schoolId
                   && canWrite(c);
    }

    // Messages – only participants may read; sender may create.
    match /messages/{messageId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.senderId
                                      || request.auth.uid == resource.data.receiverId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
    }

    // Announcements – school-scoped read; only Admin/Headmaster may post.
    match /announcements/{announcementId} {
      allow read:  if isSignedIn() && sameSchool(resource);
      allow create: if isSignedIn() && role() in ['Admin', 'Headmaster'];
    }

    // Default deny for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
