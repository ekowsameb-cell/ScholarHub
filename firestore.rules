rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
    }
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      // Note: Assuming custom claims are used for roles, e.g., token.role
      allow create: if request.auth != null && (request.auth.token.role == 'Admin' || request.auth.token.role == 'Headmaster');
    }
    // Default deny for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
